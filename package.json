{
  "name": "xlrrank",
  "version": "0.0.0",
  "private": true,
  "description": "XLRrank - platform-agnostic social, audience, relationship, content, and network intelligence platform.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:constitution": "node scripts/constitution-guard.mjs .",
    "test:constitution": "node --test scripts/guard.test.mjs",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @xlrrank/database run db:migrate",
    "db:seed": "pnpm --filter @xlrrank/database run db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules/.cache"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2"
  }
}
