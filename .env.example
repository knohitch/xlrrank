# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── URLs ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
API_PUBLIC_URL=

# ─── Ports ───────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
WORKER_CONCURRENCY=5

# ─── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
POSTGRES_USER=xlrrank
POSTGRES_PASSWORD=
POSTGRES_DB=xlrrank
DATABASE_URL=

# ─── Redis & Queues ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
QUEUE_URL=redis://redis:6379

# ─── Storage (S3-compatible or local filesystem) ───────────────────────────────
# STORAGE_DRIVER=filesystem | s3
STORAGE_DRIVER=filesystem
STORAGE_LOCAL_PATH=./storage

# S3 configuration (only required when STORAGE_DRIVER=s3)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=xlrrank
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Security secrets (generated — never commit real values) ──────────────────
# Generate with: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# ENCRYPTION_MASTER_KEY=
# SESSION_SIGNING_SECRET=
# SESSION_ENCRYPTION_SECRET=
# PASSWORD_RESET_SECRET=

# ─── Email (console transport by default; configure SMTP for delivery) ─────────
EMAIL_TRANSPORT=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@xlrrank.app

# ─── Authentication tuning ──────────────────────────────────────────────────────
# SESSION_COOKIE_SECURE=auto
# SESSION_MAX_AGE_DAYS=30
# EMAIL_VERIFY_EXPIRY_MINUTES=60
# PASSWORD_RESET_EXPIRY_MINUTES=30
# RATE_LIMIT_STORE=redis
# RATE_LIMIT_SIGNIN_LIMIT=10
# RATE_LIMIT_SIGNUP_LIMIT=20
# RATE_LIMIT_RECOVERY_LIMIT=5
# RATE_LIMIT_TOKEN_LIMIT=20
# RATE_LIMIT_WINDOW_SECONDS=900

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=

# ─── AI routing policy (required in production; no provider credentials here) ──
AI_ROUTING_POLICY_JSON={}

# ─── Optional provider credentials/endpoints ──────────────────────────────────
# AI provider credentials are optional until enabled in the application.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
#
# Social provider credentials are optional until the provider is configured.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
