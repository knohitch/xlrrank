{
  "name": "@xlrrank/api",
  "version": "0.0.0",
  "private": true,
  "description": "XLRrank TypeScript backend API.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@xlrrank/auth": "workspace:*",
    "@xlrrank/config": "workspace:*",
    "@xlrrank/database": "workspace:*",
    "@xlrrank/observability": "workspace:*",
    "@xlrrank/queue": "workspace:*",
    "@xlrrank/shared": "workspace:*",
    "@xlrrank/social-core": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "nodemailer": "^9.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
