    "@xlrrank/observability": "workspace:*",
    "@xlrrank/queue": "workspace:*",
    "@xlrrank/shared": "workspace:*",
    "@xlrrank/social-core": "workspace:*",
    "bullmq": "^5.34.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
