{
  "name": "@xlrrank/worker",
  "version": "0.0.0",
  "private": true,
  "description": "XLRrank background job workers.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --test test/*.e2e.mjs",
    "typecheck": "tsc --noEmit",
