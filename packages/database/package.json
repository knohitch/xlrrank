{
  "name": "@xlrrank/database",
  "version": "0.0.0",
  "private": true,
  "description": "XLRrank database: PostgreSQL schema, migrations, repositories.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/run-migrate.ts",
    "db:generate": "tsx --tsconfig tsconfig.drizzle.json node_modules/drizzle-kit/bin.cjs generate",
    "db:seed": "tsx src/run-seed.ts"
  },
  "dependencies": {
    "@xlrrank/auth": "workspace:*",
    "@xlrrank/config": "workspace:*",
    "@xlrrank/intelligence": "workspace:*",
    "@xlrrank/queue": "workspace:*",
    "@xlrrank/shared": "workspace:*",
    "@xlrrank/social-core": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
